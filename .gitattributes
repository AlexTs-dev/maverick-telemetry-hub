# This repo is developed on Windows but deployed to a Linux (Raspberry Pi).
# Force LF on files the Pi executes or parses so Windows CRLF endings can't
# break them — e.g. a CRLF shebang fails with "bad interpreter: /bin/bash^M".
*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
# kanshi parses this on the Pi; a trailing CRLF would corrupt the last token.
deploy/kanshi.config text eol=lf
# mosquitto and chrony parse these on the Pi/Jetson. A CRLF here is not
# cosmetic: mosquitto reads the CR as part of the value and refuses to start.
*.conf    text eol=lf
