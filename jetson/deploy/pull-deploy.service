# jetson/deploy/pull-deploy.service
# Install ON THE JETSON (not the Pi):
#   sudo cp jetson/deploy/pull-deploy.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pull-deploy.timer

[Unit]
Description=Maverick Vision — Pull Deploy (Jetson)
Documentation=https://github.com/AlexTs-dev/maverick-telemetry-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jetson
WorkingDirectory=/home/jetson/maverick-telemetry-hub
ExecStart=/home/jetson/maverick-telemetry-hub/jetson/deploy/pull-deploy.sh

# A oneshot has no default start timeout. Without this, a hung ExecStart would
# stay "activating" forever and, because pull-deploy.timer is OnUnitActiveSec,
# freeze all future deploys. Generous enough for a slow model download over a
# weak link.
TimeoutStartSec=600

# Optional: set a GitHub token for higher API rate limits (60 → 5000 req/hr)
# EnvironmentFile=/home/jetson/.maverick-env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pull-deploy

[Install]
WantedBy=multi-user.target
