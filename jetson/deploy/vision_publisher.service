# jetson/deploy/vision_publisher.service
# Install ON THE JETSON (not the Pi):
#   sudo cp jetson/deploy/vision_publisher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vision_publisher

[Unit]
Description=Maverick Vision — Jetson snapshot publisher
Documentation=https://github.com/AlexTs-dev/maverick-telemetry-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/maverick-telemetry-hub/jetson
ExecStart=/home/jetson/maverick-telemetry-hub/jetson/venv/bin/python vision_publisher.py

# Restart policy — always restart on failure, with 5s delay
Restart=always
RestartSec=5

# Give it 10s to shut down cleanly before killing it
TimeoutStopSec=10

# Log to journald — view with: journalctl -u vision_publisher -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vision_publisher

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=MQTT_HOST=192.168.100.1
# Environment=VISION_SOURCE=test

# Dashcam recording. OFF here on purpose — turn it on per device in
# ~/.maverick-env (bootstrap.sh writes VISION_RECORD_ENABLED=0 there), so
# landing this code on a Jetson never changes its behaviour until somebody
# deliberately enables it. The camera is shared with YOLO inference via a tee;
# if recording cannot start, camera.py falls back to cv2.VideoCapture and
# inference keeps running.
Environment=VISION_RECORD_ENABLED=0
Environment=MAVERICK_DASHCAM_ROOT=/var/lib/maverick-dashcam
# Environment=VISION_RECORD_SOURCE=auto      # auto | csi | usb | test
# Environment=VISION_RECORD_DEVICE=/dev/video0
# Environment=VISION_RECORD_WIDTH=1920
# Environment=VISION_RECORD_HEIGHT=1080
# Environment=VISION_RECORD_FPS=30
# Environment=VISION_RECORD_BITRATE=8000000
# Environment=VISION_RECORD_SEGMENT_S=60
# Environment=MAVERICK_DASHCAM_RETENTION_DAYS=30
# Environment=MAVERICK_DASHCAM_MAX_BYTES=128849018880       # 120 GiB
# Environment=MAVERICK_DASHCAM_MIN_FREE_BYTES=10737418240   # 10 GiB

# CSI (Argus) image tuning. Applied by recorder.py to nvarguscamerasrc only —
# USB profiles are unaffected. The shipped defaults cap the shutter at 1/250s
# and disable TNR/edge-enhancement, because Argus defaults smear a moving scene
# and the sign detector then gets unreadable frames exactly when a sign passes.
# Trading noise for sharpness is deliberate. See jetson/CAMERA-TUNING.md.
# Override per device in ~/.maverick-env, not here.
# Environment=VISION_CSI_TUNING=1                 # 0 restores stock Argus behaviour
# Environment=VISION_CSI_EXPOSURE_MAX_US=4000     # 1/250s; 2000 = 1/500s
# Environment=VISION_CSI_EXPOSURE_MIN_US=13
# Environment=VISION_CSI_GAIN_MAX=16
# Environment=VISION_CSI_ISP_GAIN_MAX=8
# Environment=VISION_CSI_TNR_MODE=0               # 0 off, 1 fast, 2 quality
# Environment=VISION_CSI_EE_MODE=0                # edge enhancement, same scale
# Environment=VISION_CSI_AEANTIBANDING=0          # 0 off, 1 auto, 2 50Hz, 3 60Hz
# Environment=VISION_CSI_SENSOR_MODE=-1           # -1 = let Argus choose
# Environment=VISION_CSI_FLIP=0                   # 2 = 180deg, inverted mount

# Per-device overrides, e.g. when the Jetson reaches the Pi over WiFi instead of
# the direct ethernet link. Listed AFTER the Environment= lines so it wins.
# The leading '-' makes it optional. This file is NOT in git, so a device-
# specific MQTT_HOST survives every pull-deploy:
#   echo 'MQTT_HOST=10.0.0.18' > /home/jetson/.maverick-env
EnvironmentFile=-/home/jetson/.maverick-env

[Install]
WantedBy=multi-user.target
